+func initOracleConnection(ctx context.Context,tracer trace.Tracer,config Config)(*sql.DB,error) {
+ options:=url.Values{}
+ if config.TLS {options.Set("SSL","true");options.Set("SSL VERIFY","true")}
+ options.Set("PREFETCH_ROWS","1")
+ uri:=url.URL{Scheme:"oracle",User:url.UserPassword(config.User,config.Password),Host:net.JoinHostPort(config.Host,strconv.Itoa(config.Port)),Path:"/"+config.ServiceName,RawQuery:options.Encode()}
+ connector:=go_ora.NewConnector(uri.String()).(*go_ora.OracleConnector)
+ connector.Dialer(&pinnedDialer{host:config.Host,port:config.Port,ips:config.PinnedIPs})
+ connector.WithTLSConfig(&tls.Config{MinVersion:tls.VersionTLS12,ServerName:config.Host})
+ db:=sql.OpenDB(connector);db.SetMaxOpenConns(1);db.SetMaxIdleConns(0)
+ return db,nil
 }

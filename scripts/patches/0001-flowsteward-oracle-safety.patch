+	readonly bool
+}
+
+func (*workflowCallSource) OracleDB() *sql.DB { return nil }
+func (s *workflowCallSource) RunSQL(_ context.Context, q string, p []any, readOnly bool) (any, error) {
+	s.calls++
+	s.query = q
+	s.params = p
+	s.readonly = readOnly
+	return []any{}, nil
+}
+func TestFlowStewardStaticInvokeCallPath(t *testing.T) {
+	ctx, err := testutils.ContextWithNewLogger()
+	if err != nil {
+		t.Fatal(err)
+	}
+	decoder := yaml.NewDecoder(strings.NewReader(`type: oracle-sql
+source: s
+description: bounded
+statement: SELECT :1 FROM dual
+staticParameters: '[9223372036854775807,"literal$secret"]'
+maxRows: 4
+`))
+	cfg, err := newConfig(ctx, "workflow", decoder)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tool, err := cfg.Initialize(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	source := &workflowCallSource{}
+	if _, err := tool.Invoke(ctx, source, parameters.ParamValues{{Name: "secret", Value: "must-not-expand"}}, ""); err != nil {
+		t.Fatal(err)
+	}
+	if source.calls != 1 || source.query != "SELECT * FROM (SELECT :1 FROM dual) WHERE ROWNUM <= 4" || !source.readonly || len(source.params) != 2 || source.params[0] != int64(9223372036854775807) || source.params[1] != "literal$secret" {
+		t.Fatalf("binding/row cap lost: %#v", source)
+	}
+}

+// JSON numbers are decoded precisely rather than converting every integer to float64.
+func staticParams(raw string)([]any,error){
+ decoder:=json.NewDecoder(bytes.NewBufferString(raw));decoder.UseNumber()
+ var result []any
+ if err:=decoder.Decode(&result);err!=nil{return nil,err}
+ var extra any;if err:=decoder.Decode(&extra);err!=io.EOF{return nil,fmt.Errorf("trailing JSON")}
+ if len(result)>100{return nil,fmt.Errorf("too many parameters")}
+ for i,value:=range result {switch v:=value.(type){case nil,string:case json.Number:
+  if !stringsContainsDecimal(v.String()){n,err:=v.Int64();if err!=nil{return nil,err};result[i]=n}else{n,err:=v.Float64();if err!=nil{return nil,err};result[i]=n}
+ default:return nil,fmt.Errorf("scalar parameters required")}}
